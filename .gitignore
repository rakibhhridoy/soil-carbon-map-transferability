# Raw data (~8.5 GB) — regenerate via src/acquire/*. Provenance kept in manifests/.
data/raw/

# Logs and partial downloads
logs/
*.part
*.log

# macOS metadata
._*
.DS_Store

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/

# Large intermediates (kept out; small processed/ artifacts ARE tracked)
data/interim/
data/tensors/

# LaTeX build artifacts
manuscript/*.aux
manuscript/*.bbl
manuscript/*.blg
manuscript/*.log
manuscript/*.out
manuscript/*.toc
manuscript/*.pdf

# Generated figure PDFs (regenerate via src/manuscript_assets.py); table .tex fragments ARE tracked
manuscript/figures/*.pdf

# D3 figure builder: ignore deps and intermediate SVGs (PDFs regenerated into manuscript/figures)
figures_d3/node_modules/
figures_d3/svg/

# Fetched public driver lake (regenerate via fetch_lake.sh)
data/lake/
mdbc-data-*.zip

# Personal outreach drafts (not for the public repo)
outreach/

# Docs build artifacts (regenerable)
docs/technical_guide.pdf
docs/.ipynb_checkpoints/
